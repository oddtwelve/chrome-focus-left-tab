{
  "manifest_version": 3,
  "name": "Фокус на левую вкладку",
  "version": "1.0.0",
  "description": "При закрытии активной вкладки Chrome переключается на вкладку слева, а не справа.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Фокус на левую вкладку",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "tabGroups"],
  "background": {
    "service_worker": "background.js"
  }
}
